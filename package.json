{
  "name": "dnsprobe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DNS Probe · 纯前端多解析商 DoH 解析对比",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:css": "tailwindcss -i src/app.css -o public/styles.css --minify",
