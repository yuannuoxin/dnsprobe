    "deploy:pages": "npx wrangler pages deploy public --project-name=dnsprobe",
    "preview:worker": "npx wrangler dev"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "tailwindcss": "^4.1.14"
  }
}
